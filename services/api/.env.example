# Local defaults for the UP AI Connect OpenAI-compatible API.
# Copy this file to .env; never commit real credentials.
AI_PROVIDER=university
AI_BASE_URL=https://gen.ai.kku.ac.th/upacth/api/v1
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
# Optional provider-specific budget; the app also enforces the 20,000-character source cap.
AI_MAX_INPUT_TOKENS=
